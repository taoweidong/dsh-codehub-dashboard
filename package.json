{
  "name": "dsh-codehub-dashboard",
  "version": "0.1.6",
  "description": "DSH native CodeHub workspace: GitHub organization, PR and Issue dashboard with native AI review drafts and Issue development sessions.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codehub",
    "merge-request",
    "code-review",
    "dashboard"
  ],
  "files": [
    "index.js",
    "workflows.js",
    "client.js",
    "web",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test scripts/test-data.mjs scripts/test-api.mjs scripts/test-workflows.mjs scripts/test-client.mjs && node scripts/test-host.mjs",
    "lint": "eslint .",
    "dev": "node scripts/dev.mjs",
    "check:version": "node scripts/check-version.mjs",
    "precommit": "npm run lint && npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.18",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "slots",
        "layout",
        "uiWorkspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "devDependencies": {
    "eslint": "^9.39.4"
  }
}
